{
  "name": "notevault",
  "version": "0.1.0",
  "private": true,
  "description": "NoteVault: Android app version of voiceVault (Capacitor). Record audio notes and search across them.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "cap:sync": "npx cap sync android",
    "android:build": "npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "android:install": "npx cap sync android && cd android && .\\gradlew.bat installDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.2",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "nodemailer": "^6.10.1",
    "openai": "^6.34.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "better-sqlite3": "^12.9.0",
    "playwright": "^1.59.1"
  }
}
