{
  "appId": "xyz.voicevault.app",
  "appName": "NoteVault",
  "webDir": "public",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["api.voicevault.xyz", "*.voicevault.xyz"]
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#f4efe4",
    "limitsNavigationsToAppBoundDomains": true
  }
}
